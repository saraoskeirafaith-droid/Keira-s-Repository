#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>

#define MAX_STUDENTS 50

// FUNCTION PROTOTYPES
float getScore(const char message[], float min, float max, int *blank); 
void getName(char name[]);
void sortByName();
void clearScreen();
void trimNewline(char str[]);
int validName(char name[]);
float getNumericalGrade(float grade, int isINC);
const char* getGradeDescription(float grade, int isINC);
void addStudent();
void searchStudent();
void displayAll();
void updateStudent();
void deleteStudent(); 
void saveData();
void loadData();
int nameMatch(char fullName[], char search[]);   

// NAME
int nameMatch(char fullName[], char search[]) {
    int result;
    result = (strstr(fullName, search) != NULL);
    return result;
}

// STRUCT
struct Student {
    char name[50];
    float exam;
    float pit;
    float classPerf;
    float quiz1;
    float quiz2;
    float finalGrade;
    int isINC;
};

struct Student students[MAX_STUDENTS];
int count = 0;

FILE *fp;
char filename[] = "students.txt";

// CLEAR SCREEN
void clearScreen() {
    system("cls");
}

// REMOVE NEWLINE
void trimNewline(char str[]) {
    str[strcspn(str, "\n")] = '\0';
}

// VALIDATE NAME
int validName(char name[]) {
    int i;
    for (i = 0; name[i] != '\0'; i++) {
        if (!isalpha(name[i]) && name[i] != ' ') {
            return 0;
        }
    }
    return 1;
}

// INPUT NAME 
void getName(char name[]) {
    int i;
    while (1) {
        printf("Enter Name: ");
        fgets(name, 50, stdin);
        trimNewline(name);

        if (strlen(name) == 0) {
            printf("Name cannot be empty!\n");
            continue;
        }

        if (!validName(name)) {
            printf("Invalid name! Letters only.\n");
            continue;
        }

        for (i = 0; name[i] != '\0'; i++) {
            name[i] = toupper((unsigned char)name[i]);
        }

        break;
    }
}
// INPUT SCORE
float getScore(const char message[], float min, float max, int *blank) {
    char input[50];
    float value;

    while (1) {
        printf("%s", message);
        fgets(input, sizeof(input), stdin);

        if (input[0] == '\n') {
            *blank = 1;
            return 0;
        }

        trimNewline(input);

        if (sscanf(input, "%f", &value) != 1) {
            printf("Invalid input! Numbers only.\n");
            continue;
        }

        if (value < min || value > max) {
            printf("Invalid range! Must be %.0f - %.0f\n", min, max);
            continue;
        }

        *blank = 0;
        return value;
    }
}

// SORT A-Z
void sortByName() {
    struct Student temp;
    int i, j;

    for (i = 0; i < count - 1; i++) {
        for (j = i + 1; j < count; j++) {
            if (strcmp(students[i].name, students[j].name) > 0) {
                temp = students[i];
                students[i] = students[j];
                students[j] = temp;
            }
        }
    }
}


// SAVE DATA
void saveData() {
    int i;
    fp = fopen(filename, "w");

    if (fp == NULL) {
        printf("Error saving file!\n");
        return;
    }

    for (i = 0; i < count; i++) {
        fprintf(fp, "%s,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%d\n",
                students[i].name,
                students[i].exam,
                students[i].pit,
                students[i].classPerf,
                students[i].quiz1,
                students[i].quiz2,
                students[i].finalGrade,
                students[i].isINC);
    }

    fclose(fp);
}

// LOAD DATA
void loadData() {
    char line[200];
    int parsed;

    fp = fopen(filename, "r");
    if (fp == NULL) return;

    count = 0;

    while (fgets(line, sizeof(line), fp) && count < MAX_STUDENTS) {
        trimNewline(line);

        parsed = sscanf(line, "%[^,],%f,%f,%f,%f,%f,%f,%d",
                        students[count].name,
                        &students[count].exam,
                        &students[count].pit,
                        &students[count].classPerf,
                        &students[count].quiz1,
                        &students[count].quiz2,
                        &students[count].finalGrade,
                        &students[count].isINC);

        if (parsed == 8) {
            count++;
        }
    }

    fclose(fp);
}

// NUMERICAL GRADE
float getNumericalGrade(float grade, int isINC) {
    int roundedGrade;
    if (isINC) return 0.0;

    roundedGrade = (int)(grade + 0.5);

    if (roundedGrade >= 97) return 1.00;
    if (roundedGrade >= 94) return 1.25;
    if (roundedGrade >= 91) return 1.50;
    if (roundedGrade >= 88) return 1.75;
    if (roundedGrade >= 85) return 2.00;
    if (roundedGrade >= 82) return 2.25;
    if (roundedGrade >= 79) return 2.50;
    if (roundedGrade >= 76) return 2.75;
    if (roundedGrade == 75) return 3.00;
    if (roundedGrade >= 72) return 3.25;
    if (roundedGrade >= 69) return 3.50;
    if (roundedGrade >= 66) return 3.75;
    if (roundedGrade == 65) return 4.00;

    return 5.00;
}

// DESCRIPTION
const char* getGradeDescription(float grade, int isINC) {
    int rounded;
    if (isINC) return "Incomplete";

    rounded = (int)(grade + 0.5);

    if (rounded >= 97) return "Excellent";
    if (rounded >= 94) return "Very Good";
    if (rounded >= 91) return "Very Good";
    if (rounded >= 88) return "Above Average";
    if (rounded >= 85) return "Above Average";
    if (rounded >= 82) return "Average";
    if (rounded >= 79) return "Average";
    if (rounded >= 76) return "Passing";
    if (rounded == 75) return "Passing";
    if (rounded >= 72) return "Passing";

    return "Failed";
}

// ADD STUDENT
void addStudent() {
    struct Student s;
    int blank = 0;

    clearScreen();

    if (count >= MAX_STUDENTS) {
        printf("Class is full!\n");
        system("pause");
        return;
    }

    printf("===== ADD STUDENT =====\n\n");

    getName(s.name);

    s.isINC = 0;

    blank = 0;
    s.exam = getScore("Exam (0-80)               : ", 0, 80, &blank);
    if (blank) s.isINC = 1;

    blank = 0;
    s.pit = getScore("PIT (0-100)               : ", 0, 100, &blank);
    if (blank) s.isINC = 1;

    blank = 0;
    s.classPerf = getScore("Class Performance (0-100) : ", 0, 100, &blank);
    if (blank) s.isINC = 1;

    blank = 0;
    s.quiz1 = getScore("Quiz 1 (0-20)             : ", 0, 20, &blank);
    if (blank) s.isINC = 1;

    blank = 0;
    s.quiz2 = getScore("Quiz 2 (0-50)             : ", 0, 50, &blank);
    if (blank) s.isINC = 1;

    if (s.isINC) {
        s.finalGrade = 0;
    } else {
        s.finalGrade =
            ((s.exam / 80) * 30) +
            ((s.pit / 100) * 20) +
            ((s.classPerf / 100) * 10) +
            ((s.quiz1 / 20) * 20) +
            ((s.quiz2 / 50) * 20);
    }

    students[count++] = s;

    saveData();

    printf("\nStudent Added Successfully!\n");
    system("pause");
}

// SEARCH 
void searchStudent() {
    char name[50];
    int found = 0;
    int i;

    clearScreen();
    printf("===== SEARCH STUDENT =====\n\n");

    getName(name);

    for (i = 0; i < count; i++) {
        if (nameMatch(students[i].name, name)) {
            found = 1;

            printf("\n===== STUDENT RECORD =====\n");
            printf("%-20s : %s\n", "Name", students[i].name);
            printf("%-20s : %.2f\n", "Exam", students[i].exam);
            printf("%-20s : %.2f\n", "PIT", students[i].pit);
            printf("%-20s : %.2f\n", "Class Performance", students[i].classPerf);
            printf("%-20s : %.2f\n", "Quiz 1", students[i].quiz1);
            printf("%-20s : %.2f\n", "Quiz 2", students[i].quiz2);

            if (students[i].isINC) {
                printf("%-20s : INC\n", "Percentage");
                printf("%-20s : INC\n", "Numerical Grade");
                printf("%-20s : Incomplete\n", "Description");
            } else {
                printf("%-20s : %.2f%%\n", "Percentage", students[i].finalGrade);
                printf("%-20s : %.2f\n", "Numerical Grade", getNumericalGrade(students[i].finalGrade, 0));
                printf("%-20s : %s\n", "Description", getGradeDescription(students[i].finalGrade, 0));
            }
            break;
        }
    }

    if (!found) printf("\nStudent not found!\n");

    system("pause");
}

