// DELETE 
void deleteStudent() {
    char name[50];
    int found = 0;
    int i, j;
    char confirm[10];

    clearScreen();
    printf("===== DELETE STUDENT =====\n\n");

    if (count == 0) {
        printf("No records available to delete.\n");
        system("pause");
        return;
    }

    getName(name);

    for (i = 0; i < count; i++) {
        if (nameMatch(students[i].name, name)) {
            found = 1;

            printf("\nAre you sure? (Y/N): ");
            fgets(confirm, sizeof(confirm), stdin);
            trimNewline(confirm);

            if (toupper((unsigned char)confirm[0]) == 'Y') {
                for (j = i; j < count - 1; j++) {
                    students[j] = students[j + 1];
                }
                count--;
                saveData();
                printf("\nDeleted Successfully!\n");
            } else {
                printf("\nCanceled.\n");
            }
            break;
        }
    }

    if (!found) printf("\nStudent not found!\n");

    system("pause");
}

// DISPLAY ALL 
void displayAll() {
    int i;

    clearScreen();

    printf("===== CLASS LIST (A-Z) =====\n\n");

    if (count == 0) {
        printf("No records found.\n");
        system("pause");
        return;
    }

    sortByName();

    printf("%-3s %-20s %-12s %-10s %-15s\n",
           "No.", "Name", "Percentage", "Numerical", "Description");

    printf("------------------------------------------------------------------\n");

    for (i = 0; i < count; i++) {

        char tempName[50];
        int k, cap = 1;

        strcpy(tempName, students[i].name);

        for (k = 0; tempName[k] != '\0'; k++) {
            if (cap && isalpha(tempName[k])) {
                tempName[k] = toupper(tempName[k]);
                cap = 0;
            } else {
                tempName[k] = tolower(tempName[k]);
            }
            if (tempName[k] == ' ') cap = 1;
        }

        if (students[i].isINC) {
            printf("%-3d %-20s %-12s %-10s %-15s\n",
                   i + 1,
                   tempName,
                   "INC",
                   "INC",
                   "Incomplete");
        } else {
            char pctStr[15];
            char numStr[10];

            sprintf(pctStr, "%.2f%%", students[i].finalGrade);
            sprintf(numStr, "%.2f", getNumericalGrade(students[i].finalGrade, 0));

            printf("%-3d %-20s %-12s %-10s %-15s\n",
                   i + 1,
                   tempName,
                   pctStr,
                   numStr,
                   getGradeDescription(students[i].finalGrade, 0));
        }
    }

    printf("\n");
    system("pause");
}

// MAIN
int main() {
    int choice;
    char input[10];

    loadData();

    while (1) {
        clearScreen();

        printf("===== STUDENT GRADE SYSTEM =====\n");
        printf("1. Add Student\n");
        printf("2. Search Student\n");
        printf("3. Display All Students\n");
        printf("4. Update Student\n");
        printf("5. Delete Student\n"); 
        printf("6. Exit\n\n");        

        printf("Enter choice: ");

        fgets(input, sizeof(input), stdin);
        choice = atoi(input);

        switch (choice) {
            case 1: addStudent(); break;
            case 2: searchStudent(); break;
            case 3: displayAll(); break;
            case 4: updateStudent(); break;
            case 5: deleteStudent(); break;
            case 6:
                printf("Exiting...\n");
                return 0;
            default:
                printf("Invalid choice!\n");
                system("pause");
        }
    }

    return 0;
}
